#!/bin/bash
# Banner di login su misura - AndreaServer
TLOG=/run/banner-cputemp   # in RAM (tmpfs), azzerato ogni mezzanotte e al riavvio

cpu_temp(){ for z in /sys/class/hwmon/hwmon*/temp1_input /sys/class/thermal/thermal_zone*/temp; do
  [ -r "$z" ] && v=$(<"$z") && [ "$v" -gt 1000 ] 2>/dev/null && { echo $((v/1000)); return; }; done; }

# Modalità cron: registra la temperatura ogni 5 min / azzera a mezzanotte
if [ "$1" = "--log-temp" ]; then t=$(cpu_temp); [ -n "$t" ] && echo "$(date +%s) $t" >> "$TLOG"; exit 0; fi
if [ "$1" = "--reset-temp" ]; then : > "$TLOG"; exit 0; fi

YB='\e[93;1m'; A='\e[38;5;154m'; B='\e[1m'; W='\e[90m'; R='\e[91m'; G='\e[92m'; Y='\e[93m'; N='\e[0m'
LINE="${W} ─────────────────────────────────────────────────────${N}"
row(){ local t="${2//·/\\e[93;1m·\\e[0m}"; printf " ${A}%-10s${N} %b\n" "$1" "$t"; }   # puntini · in giallo acceso
dot(){ systemctl is-active --quiet "$1" && printf "${G}●${N}" || printf "${R}●${N}"; }

# Richieste esterne in parallelo, max 3 s ciascuna
TMPD=$(mktemp -d)
curl -sf -m 3 "https://wttr.in/@@CITY@@?format=%c+%t&lang=it" > "$TMPD/wx" &
curl -sf -m 3 "https://api.open-meteo.com/v1/forecast?latitude=@@LAT@@&longitude=@@LON@@&current=wind_speed_10m,wind_direction_10m&hourly=precipitation_probability&forecast_hours=6&timezone=auto" > "$TMPD/rain" &
curl -sf -m 3 "https://api.ipify.org" > "$TMPD/wan" &

# CPU: uso % su 0,3 s
read -r _ a b c d e f g _ < /proc/stat; t1=$((a+b+c+d+e+f+g)); i1=$((d+e))
sleep 0.3
read -r _ a b c d e f g _ < /proc/stat; t2=$((a+b+c+d+e+f+g)); i2=$((d+e))
CPU=$(( 100 * ( (t2-t1) - (i2-i1) ) / (t2-t1) ))
TEMP=$(cpu_temp)
NOW=$(date +%s)
STORICO=$(awk '{ if(mn==""||$2<mn)mn=$2; if($2>mx)mx=$2; n++ } END{ if(n) printf "oggi min %d° max %d°", mn, mx }' "$TLOG" 2>/dev/null)
CORES=$(nproc)
read -r L1 L5 L15 _ < /proc/loadavg
read -r RT RU <<< "$(free -m | awk '/Mem:/{print $2, $3}')"
RP=$((100*RU/RT))
UP=$(uptime -p | sed 's/up //; s/ hours\?/h/; s/ minutes\?/m/; s/ days\?/g/; s/ weeks\?/sett/; s/,//g')
GG=(domenica lunedì martedì mercoledì giovedì venerdì sabato)
MM=(gennaio febbraio marzo aprile maggio giugno luglio agosto settembre ottobre novembre dicembre)
DATA="${GG[$(date +%w)]} $(date +%-d) ${MM[$(( $(date +%-m) - 1 ))]} $(date +%Y) · $(date +%H:%M)"

disk(){ df -h --output=used,size,pcent "$1" 2>/dev/null | tail -1 | awk '{print $1"/"$2" ("$3")"}'; }

# Pi-hole: statistiche di oggi
PH=$(pihole api stats/summary 2>/dev/null)
PT=$(jq -r '.queries.total // "?"' <<< "$PH" 2>/dev/null)
PB=$(jq -r '.queries.blocked // "?"' <<< "$PH" 2>/dev/null)
PP=$(jq -r '.queries.percent_blocked // 0 | floor' <<< "$PH" 2>/dev/null)
# Pi-hole: client attivi negli ultimi 10 minuti (escluso il server stesso)
CLIENTS=$(pihole api "queries?from=$((NOW-600))&length=5000" 2>/dev/null \
  | jq -r '.queries[] | select(.client.ip != "127.0.0.1" and .client.ip != "::1") | "\(.client.ip)|\(.client.name // "")"' 2>/dev/null \
  | sort | uniq -c | sort -rn | head -6)

# WireGuard: peer con handshake negli ultimi 3 minuti
WGT=0; WGO=0
while read -r _ ts; do WGT=$((WGT+1)); [ "$ts" -gt 0 ] && [ $((NOW-ts)) -lt 180 ] && WGO=$((WGO+1)); done < <(wg show wg0 latest-handshakes 2>/dev/null)

# Aggiornamenti: conteggio da cache (aggiornata in background ogni 6 ore)
UC=/run/banner-updates
if [ ! -f "$UC" ] || [ -n "$(find "$UC" -mmin +360 2>/dev/null)" ]; then
  ( apt list --upgradable 2>/dev/null | grep -c upgradable > "$UC.tmp"; mv "$UC.tmp" "$UC" ) >/dev/null 2>&1 &
  disown 2>/dev/null
fi
UPD=$(cat "$UC" 2>/dev/null || echo "…")
# Disco media: temperatura e salute SMART.
# Il ponte USB del WD non sa dire se il disco dorme, quindi per non risvegliarlo
# interroghiamo SMART solo se il disco ha avuto attività (contatori I/O cambiati),
# altrimenti mostriamo l'ultima lettura salvata in RAM.
MEDIA=@@MEDIA_MOUNT@@
MD=$(lsblk -no PKNAME "$(findmnt -no SOURCE "$MEDIA" 2>/dev/null | grep '^/dev/' | head -1)" 2>/dev/null | head -1)
SC=/run/banner-smart; MSMART=""
if command -v smartctl >/dev/null && [ -n "$MD" ] && [ -b "/dev/$MD" ]; then
  IO=$(awk '{print $1+$5}' "/sys/block/$MD/stat")
  [ -f "$SC" ] && read -r C_TS C_IO C_T C_H < "$SC"
  if [ -z "$C_TS" ] || { [ "$IO" != "$C_IO" ] && [ $((NOW - C_TS)) -ge 300 ]; }; then
    SM=$(smartctl -H -A "/dev/$MD" 2>/dev/null)
    C_T=$(awk '$1==194 || $1==190 {print $10; exit}' <<< "$SM"); C_T=${C_T:--}
    if grep -q PASSED <<< "$SM"; then C_H=OK; elif grep -q FAILED <<< "$SM"; then C_H=FAIL; else C_H=-; fi
    C_TS=$NOW; IO=$(awk '{print $1+$5}' "/sys/block/$MD/stat")
    echo "$C_TS $IO $C_T $C_H" > "$SC"
  fi
  if [ "$C_T" != "-" ]; then
    if [ "$C_T" -ge 55 ]; then TC=$R; elif [ "$C_T" -ge 45 ]; then TC=$Y; else TC='\e[97m'; fi
    MSMART="${TC}${C_T}°C${N}"
    [ $((NOW - C_TS)) -ge 600 ] && MSMART+=" ${W}(alle $(date -d @$C_TS +%H:%M))${N}"
  fi
  case $C_H in
    OK)   MSMART+=" · ${G}SMART OK${N}";;
    FAIL) MSMART+=" · \e[5;91m████${N} ${R}${B}SMART FAIL${N} ${W}→ fai subito un backup${N}";;
  esac
fi

# Ultimo backup configurazione (backup-server)
CY='\e[38;5;226m'   # giallo canarino
BK=$(ls -1t @@INDEX_MOUNT@@/backup-server/andreaserver_*.tar.gz 2>/dev/null | head -1)
if [ -n "$BK" ]; then
  BT=$(stat -c %Y "$BK")
  if [ $((NOW - BT)) -le 691200 ]; then BACKUP="backup $(date -d @$BT +%d/%m) ${CY}${B}OK${N}"
  else BACKUP="backup $(date -d @$BT +%d/%m) ${R}${B}vecchio${N} ${W}→${N} ${B}backup-server${N}"; fi
else BACKUP="${R}${B}nessun backup${N} ${W}→${N} ${B}backup-server${N}"; fi

# Stato aggiornamenti (DietPi usa i propri controlli giornalieri: /etc/cron.daily/dietpi)
. /boot/dietpi/.version 2>/dev/null
. /etc/pihole/versions 2>/dev/null
LISTA=(); CMD=()
[[ "$UPD" =~ ^[1-9][0-9]*$ ]] && { LISTA+=("sistema $UPD pacchetti"); CMD+=("apt upgrade"); }
PHNEW=""
[ "$CORE_VERSION" != "$GITHUB_CORE_VERSION" ] && PHNEW+=" Core $GITHUB_CORE_VERSION"
[ "$WEB_VERSION" != "$GITHUB_WEB_VERSION" ] && PHNEW+=" Web $GITHUB_WEB_VERSION"
[ "$FTL_VERSION" != "$GITHUB_FTL_VERSION" ] && PHNEW+=" FTL $GITHUB_FTL_VERSION"
[ -n "$PHNEW" ] && { LISTA+=("Pi-hole${PHNEW}"); CMD+=("pihole -up"); }
if [ -s /run/dietpi/.update_available ]; then LISTA+=("DietPi $(< /run/dietpi/.update_available)"); CMD+=("dietpi-update")
elif [ -f /run/dietpi/.live_patches ]; then LISTA+=("DietPi patch"); CMD+=("dietpi-update"); fi
[ -f /run/reboot-required ] && { LISTA+=("riavvio richiesto"); CMD+=("reboot"); }
# BANNER_TEST_UPD=1 banner-andreaserver  -> mostra un esempio con aggiornamenti finti
[ -n "$BANNER_TEST_UPD" ] && { LISTA=("sistema 3 pacchetti" "Pi-hole FTL v6.9"); CMD=("apt upgrade" "pihole -up"); }
if [ ${#LISTA[@]} -eq 0 ]; then
  STATUS="${G}status OK${N}"
else
  IFS=','; L="${LISTA[*]}"; C="${CMD[*]}"; unset IFS
  STATUS="\e[5;91m████${N} ${R}${B}aggiornamento:${N} ${L//,/ + } ${W}→${N} ${B}${C//,/ \&\& }${N}"
fi

wait
METEO=$(<"$TMPD/wx"); WAN=$(<"$TMPD/wan")
PIOGGIA=$(jq -r '[.hourly.precipitation_probability, .hourly.time] | transpose | max_by(.[0]) | "\(.[0])|\(.[1][11:16])"' "$TMPD/rain" 2>/dev/null)
# Vento: nome tradizionale dalla direzione di provenienza (rosa dei venti)
read -r WS WD <<< "$(jq -r '"\(.current.wind_speed_10m|round) \(.current.wind_direction_10m)"' "$TMPD/rain" 2>/dev/null)"
VENTO=""
if [ -n "$WD" ] && [ "$WD" != "null" ]; then
  # Venti locali (nomi tradizionali), rosa a 16 settori
  VN=(Tramontana Grecale Grecale Levante Levante Scirocco Scirocco Gallipolino Ostro Libeccio Libeccio Calabrese Ponente Ponente Maestrale Maestrale)
  SG=(N NNE NE ENE E ESE SE SSE S SSW SW WSW W WNW NW NNW)
  i=$(( ( ${WD%.*} * 100 + 1125 ) % 36000 / 2250 ))
  v=${VN[$i]}
  # sopra i 40 km/h: le burrasche hanno il loro nome
  if [ "$WS" -ge 40 ]; then
    case $v in Tramontana|Grecale) v="Scorcicapre";; Scirocco) v="Sciroccone";; esac
  fi
  [ "$v" = "Ostro" ] && v="Ostro (Mezzogiorno)"
  if [ "$WS" -lt 2 ]; then VENTO="calma"; else FR=(↓ ↙ ← ↖ ↑ ↗ → ↘); f=${FR[$(( ( ${WD%.*} * 100 + 2250 ) % 36000 / 4500 ))]}
    VENTO="${B}${v}${N} ${W}(${SG[$i]})${N} $WS km/h $f"; fi
fi
rm -rf "$TMPD"
if [ -n "$PIOGGIA" ]; then
  PP_MAX=${PIOGGIA%%|*}; PP_ORA=${PIOGGIA##*|}
  if [ "$PP_MAX" -ge 50 ]; then PC=$R; elif [ "$PP_MAX" -ge 20 ]; then PC=$Y; else PC=$G; fi
  if [ "$PP_MAX" -gt 0 ]; then PIOGGIA="${PC}${PP_MAX}%${N} ${W}(ore $PP_ORA)${N}"; else PIOGGIA="${PC}0%${N}"; fi
else PIOGGIA="${W}n/d${N}"; fi

echo -e "$LINE"
WH='\e[97m'; YB='\e[93;1m'
echo -e " ${WH}${B}AndreaServer${N} ${YB}·${N}${WH} ${DATA^} · ${YB}A${N} 🔄 ${YB}M${N} 📊 ${R}${B}R${N} ⏻" | sed "s/ · / $(printf '\e[93;1m')·$(printf '\e[0m\e[97m') /g"
echo -e "$LINE"
row "CPU"     "${CPU}% · ${TEMP:-n/d}°C · ${CORES} core ${W}·${N} ${STORICO:-${W}storico di oggi in raccolta${N}}"
row "Load"    "$L1  $L5  $L15"
# barra RAM a 20 blocchi, colore secondo l'uso
RC='\e[38;5;208m'; [ $RP -ge 90 ] && RC=$R   # arancione, rosso se quasi piena
PIENI=$(( (RP*20 + 50) / 100 )); BARRA=""
for ((k=0; k<20; k++)); do [ $k -lt $PIENI ] && BARRA+="█" || BARRA+="░"; done
row "RAM"     "${RC}${BARRA:0:$PIENI}${W}${BARRA:$PIENI}${N} ${RP}% ${W}·${N} ${RU}/${RT} MiB"
row "Uptime"  "$UP"
row "IP"      "LAN $(hostname -I | awk '{print $1}') ${W}·${N} WAN ${WAN:-${W}n/d${N}}"
row "Meteo"   "@@CITY@@ ${METEO:-${W}n/d${N}} ${W}·${N} ${VENTO:-${W}vento n/d${N}} ${W}·${N} ☔ 6h: $PIOGGIA"
echo -e "$LINE"
row "Sistema" "$(disk /) · $BACKUP · $STATUS"
row "Media"   "$(disk $MEDIA) ${W}libreria${N}${MSMART:+ · $MSMART}"
row "Indice"  "$(disk @@INDEX_MOUNT@@)"
echo -e "$LINE"
row "Pi-hole" "$(dot pihole-FTL) ${PT} query · ${PB} bloccate (${PP}%)"
if [ -n "$CLIENTS" ]; then
  first=1
  while read -r n rest; do
    ip=${rest%%|*}; name=${rest#*|}
    case $ip in 10.9.0.*) tag="${W}WireGuard${N}";; 10.8.0.*) tag="${W}OpenVPN${N}";; *) tag="${W}LAN${N}";; esac
    lbl=""; [ $first = 1 ] && lbl="Client"; first=0
    row "$lbl" "$(printf '%-15s' "${name:-$ip}") $tag ${W}· $n query${N}"
  done <<< "$CLIENTS"
else
  row "Client" "${W}nessuno negli ultimi 10 minuti${N}"
fi
row "Servizi" "$(systemctl is-active --quiet jellyfin && printf "${G}●${N}" || printf "${R}■${N}") ${YB}Jellyfin (stop=K riavvio=k)${N}  $(dot smbd) Samba  $(dot openvpn@server) OpenVPN  $(dot wg-quick@wg0) WireGuard ${WGO}/${WGT}"
echo -e "$LINE"
echo -e " ${A}dietpi-launcher${N} : tutti i programmi DietPi in un posto"
echo -e " ${A}dietpi-config${N}   : configurazione del dispositivo"
echo -e " ${A}dietpi-software${N} : installa software ottimizzato"
echo -e " ${A}htop${N}            : monitor risorse"
echo -e " ${A}cpu${N}             : info e statistiche CPU"
echo
